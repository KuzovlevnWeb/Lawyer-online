# ===== Сайт =====
# Адрес сайта (canonical, sitemap, Open Graph, robots.txt)
SITE_URL=https://lawyer-online-761.netlify.app
# 1 — закрыть сайт от поисковиков (пока на сайте есть [ЗАПОЛНИТЬ]). Уберите, когда данные заполнены.
SITE_NOINDEX=1

# ===== Аналитика =====
# ID счётчика Яндекс.Метрики (только цифры). Пусто — счётчик не подключается.
PUBLIC_YM_ID=

# ===== Доставка заявок: Telegram-бот =====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/группы, куда бот пишет заявки (узнать: написать боту и открыть https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=
# 1 — отправлять в Telegram только уведомление без персональных данных (рекомендуется для 152-ФЗ, если заявки хранятся в почте в РФ)
TELEGRAM_MINIMAL=1

# ===== Доставка заявок: e-mail по SMTP =====
# Например, Яндекс 360: smtp.yandex.ru, порт 465, пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Куда отправлять заявки
LEAD_EMAIL_TO=
# От кого (по умолчанию = SMTP_USER)
LEAD_EMAIL_FROM=

# ===== Сервер заявок (для VPS / локальной разработки) =====
LEAD_PORT=8787
# production — без настроенных каналов форма вернёт ошибку; иначе заявка печатается в консоль
NODE_ENV=development
