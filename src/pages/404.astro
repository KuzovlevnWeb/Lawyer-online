---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Страница не найдена" description="Такой страницы нет. Перейдите на главную или к списку услуг." noindex>
  <PageHero eyebrow="Ошибка 404" title="Такой страницы нет" lead="Возможно, ссылка устарела. Начните с главной или посмотрите список услуг.">
    <div class="fade-up mt-8 flex flex-col gap-3 sm:flex-row" style="--delay:.6s">
      <a href="/" class="btn btn-primary">На главную <Icon name="arrow" class="arrow size-5" /></a>
      <a href="/uslugi/" class="btn btn-ghost">Все услуги</a>
    </div>
  </PageHero>
</Base>
