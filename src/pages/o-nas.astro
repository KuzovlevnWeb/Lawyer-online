---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import IsoIcon from '../components/IsoIcon.astro';
import Icon from '../components/Icon.astro';
import Fill from '../components/Fill.astro';
import { regions } from '../config/site';

const principles = [
  { title: 'Говорим, как есть', text: 'Если перспективы слабые — скажем об этом прямо. Если документ не нужен — не будем его продавать.' },
  { title: 'Не обещаем результат', text: 'Исход дела решает суд или орган. Мы отвечаем за качество документа и за то, чтобы вы понимали риски.' },
  { title: 'Объясняем простым языком', text: 'Без канцелярита в общении. Вы понимаете, что написано в документе и почему.' },
  { title: 'Бережём ваши данные', text: 'Сведения о вашей ситуации используются только для работы и не публикуются.' },
];
---
<Base
  title="О нас: два юриста с практикой более 10 лет"
  description="Мы — два юриста и супруги, в практике более 10 лет. Работаем полностью онлайн: составляем иски, жалобы, ходатайства, обращения, проводим правовую экспертизу."
>
  <PageHero
    eyebrow="О нас"
    title="Двое юристов, которые сами ведут ваш вопрос"
    lead="Мы — супруги и коллеги, в юридической практике более 10 лет. Работаем дистанционно, поэтому помогаем людям из разных городов и из-за рубежа."
    crumbs={[{ href: '/o-nas/', label: 'О нас' }]}
  />

  <section class="py-16 md:py-24">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="reveal prose-legal text-lg">
          <p>Мы начали практику <Fill>год начала практики или сколько лет работаете вместе</Fill>. За это время <Fill>кратко: в каких делах и вопросах набрали опыт — без цифр, которые нельзя подтвердить</Fill>.</p>
          <p>Онлайн-формат мы выбрали осознанно: большинству людей не нужен визит в офис, чтобы получить грамотный документ. Нужны внимательность к деталям, понятные объяснения и связь в удобном мессенджере.</p>
          <p>Над каждым вопросом работаем сами. Вы общаетесь напрямую с юристом, который готовит ваш документ, — без посредников и пересказов.</p>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2">
          {[1, 2].map((n, i) => (
            <figure class="reveal card overflow-hidden" style={`--i:${i}`}>
              <div class="relative grid aspect-[4/4.2] place-items-center overflow-hidden bg-[linear-gradient(160deg,#e9efff,#f7f9fd)]">
                <div class="dots dots-light"></div>
                <span class="relative font-display text-7xl font-bold text-accent/15">Ю{n}</span>
                <span class="absolute bottom-3 left-3 right-3 text-center text-xs"><Fill>реальное фото или без фото</Fill></span>
              </div>
              <figcaption class="p-6">
                <p class="font-display text-xl font-semibold"><Fill>имя и фамилия</Fill></p>
                <p class="mt-1 text-sm text-muted">Юрист</p>
                <p class="mt-4 text-[15px] text-muted"><Fill>специализация, образование, направления практики</Fill></p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <aside class="space-y-5 lg:col-span-5">
        <div class="reveal dark-zone relative isolate overflow-hidden rounded-[28px] p-8">
          <div class="dots -z-10 opacity-60"></div>
          <div class="grid grid-cols-2 gap-6">
            <div><p class="font-display text-4xl font-semibold text-white">10+</p><p class="mt-1 text-sm text-white/60">лет практики</p></div>
            <div><p class="font-display text-4xl font-semibold text-white">2</p><p class="mt-1 text-sm text-white/60">юриста в команде</p></div>
            <div><p class="font-display text-4xl font-semibold text-white">100%</p><p class="mt-1 text-sm text-white/60">онлайн-формат</p></div>
            <div><p class="font-display text-4xl font-semibold text-white">5 000 ₽</p><p class="mt-1 text-sm text-white/60">минимальная стоимость</p></div>
          </div>
          <IsoIcon variant="cube" dark class="iso-reveal mx-auto mt-8 h-44 w-auto" />
        </div>
        <div class="reveal card p-7" style="--i:1">
          <h2 class="text-2xl">Где мы практикуем</h2>
          <ul class="mt-5 space-y-3">
            {regions.map((r) => <li class="flex items-center gap-3"><Icon name="pin" class="size-5 text-accent" /><span><b>{r.name}</b> <span class="text-muted">{r.note}</span></span></li>)}
          </ul>
          <p class="mt-4 text-sm text-muted">Документы для клиентов из других городов и из-за рубежа готовим дистанционно.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24">
    <div class="container-x">
      <p class="reveal eyebrow text-accent">Подход</p>
      <h2 class="reveal h-section mt-4 max-w-2xl" style="--i:1">Как мы относимся к работе</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {principles.map((p, i) => (
          <div class="reveal card spot p-7" style={`--i:${i}`}>
            <span class="eyebrow text-accent">0{i + 1}</span>
            <h3 class="mt-4 text-xl">{p.title}</h3>
            <p class="mt-3 text-[15.5px] text-muted">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaSection source="about" />
</Base>
