---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import CtaSection from '../components/CtaSection.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Fill from '../components/Fill.astro';
import { faq } from '../config/site';

const blocks = [
  {
    icon: 'doc' as const,
    title: 'Оплата',
    body: ['Стоимость называем после изучения документов и до начала работы. Услуги — от 5 000 ₽.'],
    fill: 'способы оплаты (перевод, счёт, СБП), предоплата или поэтапно, выдаётся ли чек',
  },
  {
    icon: 'scale' as const,
    title: 'Договор',
    body: ['Условия работы фиксируем письменно: что именно делаем, в какой срок и за какую стоимость.'],
    fill: 'договор-оферта на сайте или подписываемый договор; как подписывается дистанционно',
  },
  {
    icon: 'lock' as const,
    title: 'Конфиденциальность',
    body: [
      'Всё, что вы рассказываете о своей ситуации, используется только для работы над вашим вопросом.',
      'Мы не публикуем данные клиентов и дел. Персональные данные обрабатываем в соответствии с политикой конфиденциальности.',
    ],
  },
  {
    icon: 'chat' as const,
    title: 'Связь',
    body: ['Общаемся в Telegram, WhatsApp, по телефону или e-mail — как удобнее вам. Документы можно присылать фото или сканами.'],
    fill: 'часы работы и срок ответа на сообщения',
  },
];
---
<Base
  title="Как мы работаем: этапы, оплата, договор, конфиденциальность"
  description="Как проходит работа с юристами онлайн: от описания ситуации до готового документа. Этапы, оплата, договор и конфиденциальность."
>
  <PageHero
    eyebrow="Как мы работаем"
    title="Понятный процесс без визита в офис"
    lead="Вы описываете ситуацию — мы изучаем документы, называем стоимость и срок, готовим документ и объясняем, что делать дальше."
    crumbs={[{ href: '/kak-my-rabotaem/', label: 'Как мы работаем' }]}
  />

  <Steps title="Пять шагов от вопроса до документа" />

  <section class="bg-white py-16 md:py-24">
    <div class="container-x">
      <p class="reveal eyebrow text-accent">Условия</p>
      <h2 class="reveal h-section mt-4 max-w-2xl" style="--i:1">Оплата, договор и конфиденциальность</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {blocks.map((b, i) => (
          <article class="reveal card spot p-7 md:p-9" style={`--i:${i % 2}`}>
            <span class="grid size-12 place-items-center rounded-2xl bg-accent/10 text-accent"><Icon name={b.icon} class="size-6" /></span>
            <h3 class="mt-6 text-2xl">{b.title}</h3>
            {b.body.map((p) => <p class="mt-3 text-muted">{p}</p>)}
            {b.fill && <p class="mt-3 text-muted"><Fill>{b.fill}</Fill></p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <Faq items={faq} />
  <CtaSection source="process" />
</Base>
