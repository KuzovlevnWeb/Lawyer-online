---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import Text from '../components/Text.astro';
import { contacts, site, regions } from '../config/site';
import { legalServiceLd } from '../lib/schema';

const channels = [
  { icon: 'telegram' as const, label: 'Telegram', value: contacts.telegramLabel, href: contacts.telegram, goal: 'messenger_click', ext: true, note: 'Самый быстрый способ связи' },
  { icon: 'whatsapp' as const, label: 'WhatsApp', value: 'Написать в WhatsApp', href: contacts.whatsapp, goal: 'messenger_click', ext: true, note: 'Можно отправлять фото документов' },
  { icon: 'phone' as const, label: 'Телефон', value: contacts.phoneLabel, href: contacts.phoneHref, goal: 'phone_click', ext: false, note: site.workHours },
  { icon: 'mail' as const, label: 'E-mail', value: contacts.emailLabel, href: contacts.email, goal: undefined, ext: false, note: 'Для документов большого объёма' },
];
---
<Base
  title="Контакты: Telegram, WhatsApp, телефон, e-mail"
  description="Свяжитесь с нами в Telegram, WhatsApp, по телефону или e-mail. Или оставьте заявку на сайте — изучим ситуацию и ответим."
  jsonLd={legalServiceLd(Astro.site!)}
>
  <PageHero
    eyebrow="Контакты"
    title="Напишите удобным способом"
    lead="Опишите ситуацию в мессенджере или через форму. Изучим её и скажем, какой документ нужен, сколько это стоит и в какой срок."
    crumbs={[{ href: '/kontakty/', label: 'Контакты' }]}
  />

  <section class="py-16 md:py-24">
    <div class="container-x">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {channels.map((c, i) => (
          <a
            href={c.href}
            target={c.ext ? '_blank' : undefined}
            rel={c.ext ? 'noopener' : undefined}
            data-goal={c.goal}
            class="reveal card card-hover spot group flex flex-col p-7"
            style={`--i:${i}`}
          >
            <span class="grid size-12 place-items-center rounded-2xl bg-accent text-white shadow-[0_10px_30px_-10px_rgba(30,79,230,0.8)] transition-transform duration-500 group-hover:scale-110"><Icon name={c.icon} class="size-6" /></span>
            <span class="eyebrow mt-6 text-soft">{c.label}</span>
            <span class="mt-2 font-display text-lg font-semibold"><Text value={c.value} /></span>
            <span class="mt-2 text-sm text-muted"><Text value={c.note} /></span>
          </a>
        ))}
      </div>

      <div class="reveal card mt-5 grid gap-6 p-7 md:grid-cols-2 md:p-9">
        <div>
          <h2 class="text-2xl">Регионы практики</h2>
          <p class="mt-3 text-muted">Мы работаем онлайн — приезжать никуда не нужно. Документы готовим дистанционно для клиентов из любых городов и из-за рубежа.</p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-3 md:grid-cols-1 lg:grid-cols-3">
          {regions.map((r) => (
            <li class="rounded-2xl border border-line p-4"><Icon name="pin" class="size-5 text-accent" /><p class="mt-2 font-semibold">{r.name}</p><p class="text-sm text-muted">{r.note}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaSection title="Или оставьте заявку здесь" source="contacts" />
</Base>
