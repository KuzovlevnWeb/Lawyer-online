---
import Icon from './Icon.astro';
import { site, contacts } from '../config/site';

// Полосы фона: прозрачность, длительность и задержка у каждой своя — эффект «живого экрана»
const stripes = [0.25, 0.55, 0.35, 0.8, 0.3, 0.6, 0.95, 0.4, 0.7, 0.3, 0.5, 0.2].map((a, i) => ({
  a,
  d: 10 + ((i * 7) % 9),
  delay: -((i * 3.3) % 11),
}));
const words = ['иск', 'жалобу', 'ходатайство', 'претензию', 'обращение'];
const titleWords = 'без визита в офис'.split(' ');
const lines = [92, 78, 86, 64, 88, 72, 40];
---
<section data-hero class="dark-zone relative isolate overflow-hidden pb-44 pt-32 md:pb-64 md:pt-40">
  <div class="stripes -z-10 opacity-70 [mask-image:linear-gradient(180deg,#000_30%,transparent_85%)]" style="--cols:12">
    {stripes.map((s) => <i style={`--a:${s.a};--d:${s.d}s;--delay:${s.delay}s`}></i>)}
  </div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_30%_30%,transparent_0%,rgba(7,11,22,0.85)_70%)]"></div>
  <div class="dots -z-10"></div>
  <div class="grain -z-10"></div>
  <span class="streak -z-10" style="top:22%;left:4%;rotate:-24deg;animation-delay:0s"></span>
  <span class="streak -z-10" style="top:58%;left:46%;rotate:-24deg;animation-delay:3.2s"></span>
  <span class="streak -z-10" style="top:12%;left:58%;rotate:-24deg;animation-delay:6.1s"></span>

  <!-- «Восход»: дуга свечения, плавно переходящая в светлый фон страницы -->
  <div class="pointer-events-none absolute left-1/2 top-[calc(100%-120px)] -z-10 h-[110vw] w-[260vw] -translate-x-1/2 rounded-[50%] bg-[linear-gradient(180deg,#5d95ff_0%,#b9d1ff_4%,#e9f0ff_12%,var(--color-paper)_22%)] shadow-[0_-30px_120px_30px_rgba(47,107,255,0.55),0_-6px_40px_4px_rgba(140,180,255,0.7)] md:top-[calc(100%-150px)] md:w-[200vw]"></div>

  <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <p class="fade-up inline-flex items-center gap-2.5 rounded-full border border-white/12 bg-white/5 px-3.5 py-1.5 text-[13px] font-medium text-white/80 backdrop-blur" style="--delay:.1s">
        <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-bright opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-accent-bright"></span></span>
        {site.status} · {site.experience} практики · работаем онлайн
      </p>

      <h1 class="mt-6 text-[clamp(2.4rem,1.3rem+3.7vw,4.9rem)] font-semibold leading-[1.02] text-white">
        <span class="sr-only">Подготовим иск, жалобу, ходатайство, претензию или обращение — без визита в офис</span>
        <span aria-hidden="true" class="blur-in block">
          <span style="--w:0">Подготовим</span><br />
          <span style="--w:1" class="!inline-flex items-center gap-[0.18em] rounded-[0.18em] bg-accent px-[0.18em] pb-[0.06em] align-baseline shadow-[0_0_60px_-10px_rgba(74,134,255,0.9)]">
            <svg class="size-[0.62em] shrink-0 translate-y-[0.04em] opacity-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6.5 3.5h7l4 4v13h-11z"/><path d="M13.5 3.5v4h4M9 12h6M9 15.5h6"/></svg>
            <span class="rotator" data-rotator>
              {words.map((w, i) => <span class:list={[{ on: i === 0 }]}>{w}</span>)}
            </span>
          </span>
          <br />
          {titleWords.map((w, i) => <span style={`--w:${i + 2}`} class="text-white/90">{w}&nbsp;</span>)}
        </span>
      </h1>

      <p class="fade-up mt-7 max-w-[34rem] text-lg leading-relaxed text-white/70 md:text-xl" style="--delay:.7s">
        Два юриста с практикой более 10 лет. Составляем иски, ходатайства, жалобы и обращения в органы, проводим правовую экспертизу. Документы и связь — полностью онлайн.
      </p>

      <div class="fade-up mt-9 flex flex-col gap-3 sm:flex-row" style="--delay:.85s">
        <a href="#zayavka" class="btn btn-primary">Описать ситуацию <Icon name="arrow" class="arrow size-5" /></a>
        <a href={contacts.telegram} target="_blank" rel="noopener" data-goal="messenger_click" class="btn btn-ghost"><Icon name="telegram" class="size-5" /> Написать в Telegram</a>
      </div>

      <dl class="fade-up mt-12 grid max-w-[34rem] grid-cols-3 gap-4 border-t border-white/10 pt-6" style="--delay:1s">
        <div><dt class="sr-only">Опыт</dt><dd class="font-display whitespace-nowrap text-xl font-semibold text-white sm:text-2xl md:text-3xl">10+</dd><dd class="mt-1 text-[13px] leading-snug text-white/55">лет юридической практики</dd></div>
        <div><dt class="sr-only">Формат</dt><dd class="font-display whitespace-nowrap text-xl font-semibold text-white sm:text-2xl md:text-3xl">100%</dd><dd class="mt-1 text-[13px] leading-snug text-white/55">онлайн, из любого города</dd></div>
        <div><dt class="sr-only">Стоимость</dt><dd class="font-display whitespace-nowrap text-xl font-semibold text-white sm:text-2xl md:text-3xl">от 5 000 ₽</dd><dd class="mt-1 text-[13px] leading-snug text-white/55">стоимость услуг</dd></div>
      </dl>
    </div>

    <!-- Визуал: документ «собирается» на глазах -->
    <div class="fade-up relative mx-auto w-full max-w-[420px] lg:col-span-5 lg:max-w-none" style="--delay:.5s" aria-hidden="true">
      <div data-parallax class="[perspective:1400px]">
        <div class="doc-float">
          <div class="relative rounded-[22px] border border-white/12 bg-[linear-gradient(160deg,rgba(28,44,92,0.75),rgba(9,14,30,0.85))] p-6 shadow-[0_40px_120px_-30px_rgba(30,79,230,0.75)] backdrop-blur-xl transition-transform duration-700 ease-out [transform:rotateX(var(--rx,6deg))_rotateY(var(--ry,-10deg))] md:p-7">
            <div class="relative overflow-hidden rounded-[14px]">
              <div class="bars grid h-28 grid-rows-7 gap-[3px] md:h-32">
                {[0.7, 0.9, 0.55, 1, 0.8, 0.6, 0.85].map((w, i) => <i style={`width:${w * 100}%;--d:${4 + i * 0.7}s;animation-delay:-${i * 0.9}s;margin-left:${(1 - w) * (i % 2 ? 100 : 30)}%`}></i>)}
              </div>
              <div class="scan"></div>
            </div>

            <div class="mt-6 flex items-center justify-between">
              <span class="eyebrow text-accent-bright">Исковое заявление</span>
              <span class="text-[11px] font-medium text-white/40">черновик · v3</span>
            </div>
            <div class="mt-4 space-y-2.5">
              {lines.map((w, n) => <div class="typing-line h-[7px] rounded-full bg-white/15" style={`width:${w}%;--n:${n}`}></div>)}
            </div>

            <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-5">
              <div class="flex -space-x-2">
                <span class="grid size-8 place-items-center rounded-full border-2 border-[#0e1733] bg-accent text-[11px] font-bold text-white">Ю1</span>
                <span class="grid size-8 place-items-center rounded-full border-2 border-[#0e1733] bg-[#2b3d73] text-[11px] font-bold text-white">Ю2</span>
              </div>
              <span class="stamp inline-flex items-center gap-1.5 rounded-lg border-2 border-accent-bright/70 px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent-bright">
                <Icon name="check" class="size-3.5" /> Готов к подаче
              </span>
            </div>
          </div>

          <div class="absolute -left-3 -top-4 hidden rounded-lg bg-white px-3 py-2 text-[12px] font-semibold text-ink shadow-xl sm:block md:-left-10" style="animation: float 6s ease-in-out -2s infinite">
            <span class="text-accent">▲</span> Шаг 2 · анализ документов
          </div>
          <div class="absolute -bottom-5 right-4 flex items-center gap-2 rounded-lg bg-ink px-3 py-2 text-[12px] font-semibold text-white shadow-xl ring-1 ring-white/15 md:-right-6" style="animation: float 6.5s ease-in-out -4s infinite">
            <Icon name="telegram" class="size-4 text-accent-bright" /> Новое сообщение
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
