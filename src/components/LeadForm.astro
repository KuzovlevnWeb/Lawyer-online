---
import Icon from './Icon.astro';
import { contacts } from '../config/site';
interface Props { source?: string }
const { source = 'site' } = Astro.props;
---
<form class="lead-form relative space-y-4" novalidate data-source={source} action="/api/lead/" method="post">
  <div class="grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-2 block text-sm font-medium text-white/80">Имя</span>
      <input class="field" name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" placeholder="Как к вам обращаться" />
    </label>
    <label class="block">
      <span class="mb-2 block text-sm font-medium text-white/80">Контакт для связи</span>
      <input class="field" name="contact" type="text" autocomplete="tel" required minlength="3" maxlength="150" placeholder="Telegram, телефон или e-mail" />
    </label>
  </div>
  <label class="block">
    <span class="mb-2 block text-sm font-medium text-white/80">Кратко о ситуации</span>
    <textarea class="field min-h-[132px] resize-y" name="message" required minlength="10" maxlength="3000" placeholder="Например: магазин отказался вернуть деньги за товар, претензию проигнорировал. Хочу подать иск."></textarea>
  </label>

  <!-- Защита от спама: поле-ловушка (люди его не видят) и метка времени -->
  <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label>Ваш сайт <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <input type="hidden" name="ts" value="" />

  <label class="flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-white/70">
    <span class="relative mt-0.5 grid size-5 shrink-0 place-items-center">
      <input type="checkbox" name="consent" required class="consent peer absolute inset-0 size-5 cursor-pointer appearance-none rounded-md border border-white/30 bg-white/5 transition checked:border-accent-bright checked:bg-accent-bright aria-[invalid=true]:border-red-300" />
      <svg class="pointer-events-none relative size-3.5 text-white opacity-0 peer-checked:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7"/></svg>
    </span>
    <span>Даю <a href="/soglasie-na-obrabotku/" target="_blank" class="text-white underline underline-offset-2 hover:text-accent-bright">согласие на обработку персональных данных</a> и подтверждаю, что ознакомлен(а) с <a href="/politika-konfidencialnosti/" target="_blank" class="text-white underline underline-offset-2 hover:text-accent-bright">политикой конфиденциальности</a>.</span>
  </label>

  <p class="form-error hidden rounded-xl border border-red-300/30 bg-red-400/10 px-4 py-3 text-sm text-red-100" role="alert"></p>

  <button type="submit" class="btn btn-primary w-full sm:w-auto">
    <span class="btn-label">Отправить заявку</span>
    <Icon name="arrow" class="arrow size-5" />
  </button>
  <p class="text-xs text-white/60">Не пишите в форме паспортные данные и другие чувствительные сведения — запросим их отдельно, если понадобятся.</p>

  <div class="form-success absolute inset-0 z-20 hidden flex-col items-center justify-center rounded-2xl bg-ink-2 p-6 text-center" role="status" aria-live="polite">
    <span class="grid size-16 place-items-center rounded-full bg-accent text-white shadow-[0_0_50px_-5px_rgba(74,134,255,0.9)]"><Icon name="check" class="size-8" /></span>
    <p class="mt-6 font-display text-2xl font-semibold text-white">Заявка отправлена</p>
    <p class="mt-3 max-w-sm text-white/65">Спасибо! Мы изучим ситуацию и свяжемся с вами по указанному контакту.</p>
    <a href={contacts.telegram} target="_blank" rel="noopener" data-goal="messenger_click" class="mt-6 text-sm font-semibold text-accent-bright underline underline-offset-4">Срочно? Напишите в Telegram</a>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    const ts = form.querySelector<HTMLInputElement>('input[name="ts"]');
    if (ts) ts.value = String(Date.now());
    const err = form.querySelector<HTMLElement>('.form-error')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = btn.querySelector<HTMLElement>('.btn-label')!;
    const success = form.querySelector<HTMLElement>('.form-success')!;

    const showError = (msg: string) => {
      err.textContent = msg;
      err.classList.remove('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));

      const fd = new FormData(form);
      const data = {
        name: String(fd.get('name') ?? '').trim(),
        contact: String(fd.get('contact') ?? '').trim(),
        message: String(fd.get('message') ?? '').trim(),
        consent: fd.get('consent') === 'on',
        website: String(fd.get('website') ?? ''),
        ts: Number(fd.get('ts') ?? 0),
        page: location.pathname,
        source: form.dataset.source,
      };

      const invalid: string[] = [];
      if (data.name.length < 2) invalid.push('name');
      if (data.contact.length < 3) invalid.push('contact');
      if (data.message.length < 10) invalid.push('message');
      if (invalid.length) {
        invalid.forEach((n) => form.querySelector(`[name="${n}"]`)?.setAttribute('aria-invalid', 'true'));
        (form.querySelector(`[name="${invalid[0]}"]`) as HTMLElement | null)?.focus();
        return showError('Пожалуйста, заполните имя, контакт и коротко опишите ситуацию (от 10 символов).');
      }
      if (!data.consent) {
        form.querySelector('.consent')?.setAttribute('aria-invalid', 'true');
        return showError('Без согласия на обработку персональных данных мы не можем принять заявку.');
      }

      btn.disabled = true;
      label.textContent = 'Отправляем…';
      try {
        const res = await fetch('/api/lead/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) throw new Error(json.error || 'Не удалось отправить заявку.');
        success.classList.remove('hidden');
        success.classList.add('flex');
        form.reset();
        window.reachGoal?.('form_submit');
      } catch (e) {
        showError(`${(e as Error).message} Попробуйте ещё раз или напишите нам в мессенджер.`);
      } finally {
        btn.disabled = false;
        label.textContent = 'Отправить заявку';
      }
    });
  });
</script>
