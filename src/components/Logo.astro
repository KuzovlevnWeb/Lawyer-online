---
import { site } from '../config/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href="/" class={`group inline-flex items-center gap-2.5 ${cls}`}>
  <span class="relative grid size-9 place-items-center overflow-hidden rounded-[11px] bg-accent text-white shadow-[0_6px_20px_-6px_rgba(30,79,230,0.8)]">
    <span class="absolute inset-0 bg-[linear-gradient(160deg,#6aa3ff_0%,#1e4fe6_45%,#0b1a3d_100%)]"></span>
    <svg class="relative size-[18px] transition-transform duration-700 group-hover:rotate-[360deg]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M15.5 5.5c-.8-1.3-2.1-2-3.6-2-2.2 0-3.9 1.4-3.9 3.3 0 4.2 8.2 3.4 8.2 7.7 0 1.2-.7 2.2-1.9 2.8M8.5 18.5c.8 1.3 2.1 2 3.6 2 2.2 0 3.9-1.4 3.9-3.3 0-4.2-8.2-3.4-8.2-7.7 0-1.2.7-2.2 1.9-2.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </span>
  <span class="flex flex-col leading-none">
    <span class="whitespace-nowrap font-display text-[15px] font-bold tracking-tight">{site.brand}</span>
    <span class="mt-1 whitespace-nowrap text-[11px] font-medium opacity-60">онлайн · {site.experience} практики</span>
  </span>
</a>
