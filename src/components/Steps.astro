---
import Text from './Text.astro';
import { steps } from '../config/site';
interface Props { title?: string; intro?: string }
const { title = 'Как проходит работа', intro = 'Без визитов в офис и лишней бюрократии. Вы всегда знаете, что происходит и что будет дальше.' } = Astro.props;
---
<section class="relative py-20 md:py-28" id="kak-rabotaem">
  <div class="container-x grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-32">
        <p class="reveal eyebrow text-accent">Процесс</p>
        <h2 class="reveal h-section mt-4" style="--i:1">{title}</h2>
        <p class="reveal mt-5 max-w-md text-muted" style="--i:2">{intro}</p>
        <a href="#zayavka" class="reveal btn btn-primary mt-8" style="--i:3">Начать с описания ситуации</a>
      </div>
    </div>
    <ol class="relative lg:col-span-7" data-steps>
      <span class="absolute bottom-6 left-[23px] top-6 w-px bg-line" aria-hidden="true"></span>
      <span class="progress-line absolute bottom-6 left-[23px] top-6 w-px bg-gradient-to-b from-accent-bright via-accent to-accent" aria-hidden="true"></span>
      {steps.map((s, i) => (
        <li class="step reveal relative flex gap-6 pb-10 last:pb-0 md:gap-8" data-step>
          <span class="step-num relative z-10 grid size-12 shrink-0 place-items-center rounded-full border border-line bg-white font-display text-base font-bold text-muted transition-all duration-500">
            {i + 1}
          </span>
          <div class="pt-2">
            <h3 class="text-xl md:text-2xl">{s.title}</h3>
            <p class="mt-2.5 max-w-lg text-muted"><Text value={s.text} /></p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .step.active .step-num {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    box-shadow: 0 0 0 6px rgba(30, 79, 230, 0.12), 0 10px 30px -8px rgba(30, 79, 230, 0.7);
  }
</style>
