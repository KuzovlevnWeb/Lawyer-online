---
import Icon from './Icon.astro';
import { contacts } from '../config/site';
---
<div class="mobile-bar fixed inset-x-3 bottom-3 z-40 md:hidden" data-mobile-bar>
  <div class="flex items-center gap-2 rounded-2xl border border-white/10 bg-ink/90 p-2 shadow-[0_20px_50px_-15px_rgba(7,11,22,0.7)] backdrop-blur-xl">
    <a href={contacts.telegram} target="_blank" rel="noopener" data-goal="messenger_click" aria-label="Написать в Telegram" class="grid size-12 shrink-0 place-items-center rounded-xl bg-white/8 text-white"><Icon name="telegram" class="size-5" /></a>
    <a href={contacts.whatsapp} target="_blank" rel="noopener" data-goal="messenger_click" aria-label="Написать в WhatsApp" class="grid size-12 shrink-0 place-items-center rounded-xl bg-white/8 text-white"><Icon name="whatsapp" class="size-5" /></a>
    <a href={contacts.phoneHref} data-goal="phone_click" aria-label="Позвонить" class="grid size-12 shrink-0 place-items-center rounded-xl bg-white/8 text-white"><Icon name="phone" class="size-5" /></a>
    <a href="/#zayavka" class="btn btn-primary !min-h-12 flex-1 !rounded-xl !px-3 text-[15px]">Оставить заявку</a>
  </div>
</div>
