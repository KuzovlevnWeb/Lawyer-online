---
import IsoIcon from './IsoIcon.astro';
import Icon from './Icon.astro';
interface Props {
  id: string;
  title: string;
  situation: string;
  short: string;
  price: string;
  icon: 'stack' | 'upright' | 'arrow' | 'envelope' | 'parties' | 'cube';
  index: number;
}
const { id, title, situation, short, price, icon, index } = Astro.props;
---
<a
  href={`/uslugi/${id}/`}
  class="reveal card card-hover spot group relative flex flex-col overflow-hidden p-6 md:p-7"
  style={`--i:${index % 3}`}
>
  <div class="flex items-start justify-between gap-4">
    <span class="eyebrow text-accent">{String(index + 1).padStart(2, '0')} · {title}</span>
    <span class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-text transition-all duration-500 group-hover:rotate-[-45deg] group-hover:border-accent group-hover:bg-accent group-hover:text-white">
      <Icon name="arrow" class="size-4" />
    </span>
  </div>
  <div class="relative my-6 h-36 md:h-40">
    <div class="absolute inset-0 rounded-2xl bg-[radial-gradient(ellipse_at_center,rgba(30,79,230,0.07),transparent_70%)]"></div>
    <IsoIcon variant={icon} class="relative mx-auto h-full w-auto transition-transform duration-700 group-hover:-translate-y-1.5 group-hover:scale-[1.03]" />
  </div>
  <h3 class="text-[1.4rem] leading-tight md:text-[1.55rem]">{situation}</h3>
  <p class="mt-3 text-[15.5px] text-muted">{short}</p>
  <div class="mt-auto flex items-center justify-between pt-6 text-sm">
    <span class="font-semibold text-text">{price}</span>
    <span class="font-medium text-accent opacity-0 transition-all duration-500 group-hover:translate-x-0 group-hover:opacity-100 md:-translate-x-2">Подробнее</span>
  </div>
</a>
